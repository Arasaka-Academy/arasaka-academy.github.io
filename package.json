{
  "name": "arasaka-academy-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "preview": "serve out -l tcp://127.0.0.1:4173 --no-clipboard --no-port-switching",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "audit:performance": "node scripts/audit-performance.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "^1.22.1",
    "tailwindcss": "4.3.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "lighthouse": "^13.0.0",
    "serve": "^14.2.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
